---
import { render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

import {
  getPublishedPosts,
  getPostSlug,
  getCategoryLabel,
  formatPostDate,
} from "../../lib/posts.ts";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();

  return posts.map((post) => ({
    params: {
      slug: getPostSlug(post),
    },
    props: {
      post,
    },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const categoryLabel = getCategoryLabel(post.data.category);
const date = formatPostDate(post.data.pubDate);
---

<BaseLayout title={`${post.data.title} | d0ucube`} description={post.data.description}>
  <main class="mx-auto max-w-4xl px-4 py-10">
    <article class="rounded-[2rem] border border-white/10 bg-slate-950/45 p-6 shadow-2xl backdrop-blur-2xl md:p-10">
      <header class="border-b border-white/10 pb-6">
        <p class="text-xs uppercase tracking-[0.3em] text-blue-200/70">
          {categoryLabel} · {date}
        </p>

        <h1 class="mt-4 text-3xl font-black leading-tight text-white md:text-5xl">
          {post.data.title}
        </h1>

        <p class="mt-4 text-sm leading-7 text-slate-300">
          {post.data.description}
        </p>

        <div class="mt-5 flex flex-wrap gap-2">
          {post.data.tags.map((tag) => (
            <a
              href={`/search?q=${tag}`}
              class="rounded-xl border border-white/10 bg-black/20 px-3 py-2 text-xs text-slate-200 transition hover:border-blue-300/60 hover:bg-blue-500/15"
            >
              #{tag}
            </a>
          ))}
        </div>
      </header>

      <div class="article-content mt-8">
        <Content />
      </div>
    </article>
  </main>
</BaseLayout>
