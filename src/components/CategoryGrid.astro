---
import { siteConfig } from "../data/site.ts";

const meta: Record<string, { icon: string; note: string }> = {
  security: { icon: "🛡️", note: "Security Notes" },
  ctf: { icon: "🚩", note: "Writeup Lab" },
  essay: { icon: "✍️", note: "Mood Archive" },
  travel: { icon: "🧳", note: "Travel Log" },
};
---

<section class="space-y-5">
  {siteConfig.categories.map((category) => (
    <a
      href={`/categories/${category.slug}`}
      class="group relative block min-h-[150px] overflow-hidden rounded-[2rem] border border-white/10 bg-slate-950/45 p-6 shadow-xl backdrop-blur-2xl transition duration-300 hover:-translate-y-1 hover:border-blue-300/70 hover:bg-slate-950/60"
    >
      <div class="absolute inset-y-0 right-0 w-1/3 bg-gradient-to-l from-blue-500/10 to-transparent opacity-0 transition duration-300 group-hover:opacity-100"></div>

      <div class="relative flex items-start gap-5">
        <div class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-white/10 bg-black/30 text-2xl shadow-inner">
          {meta[category.slug]?.icon}
        </div>

        <div>
          <p class="mb-2 text-xs uppercase tracking-[0.28em] text-blue-200/70">
            {meta[category.slug]?.note}
          </p>

          <h2 class="text-2xl font-black text-white group-hover:text-blue-100">
            {category.title}
          </h2>

          <p class="mt-3 max-w-3xl text-sm leading-7 text-slate-200">
            {category.description}
          </p>
        </div>
      </div>
    </a>
  ))}
</section>
