---
// src/components/PostCard.astro
interface Props {
  post: any; // 这里接收一篇文章的数据
}

const { post } = Astro.props;
---

<a href={`/posts/${post.collection}/${post.slug}/`} class="block p-6 bg-zinc-900 border border-zinc-800 rounded-xl hover:border-zinc-500 transition-colors">
  <h3 class="text-xl font-bold text-zinc-100 mb-2">{post.data.title}</h3>
  <p class="text-zinc-400 text-sm mb-4">{post.data.date}</p>
  <p class="text-zinc-300 line-clamp-2">{post.data.description}</p>
  
  <!-- 简单的分类标签 -->
  <div class="mt-4">
    <span class="text-xs font-mono text-zinc-500 border border-zinc-800 px-2 py-1 rounded">
      {post.data.category}
    </span>
  </div>
</a>