---
interface Props {
  title: string;
  description: string;
  category: string;
  date: string;
  href?: string;
  variant?: "dark" | "paper";
}

const {
  title,
  description,
  category,
  date,
  href = "#",
  variant = "dark",
} = Astro.props;

const isPaper = variant === "paper";

const cardClass = isPaper
  ? "group block min-h-[150px] rounded-[1.6rem] border border-slate-300 bg-white/85 p-6 shadow-sm transition duration-300 hover:-translate-y-0.5 hover:border-blue-400/60 hover:bg-white"
  : "group block min-h-[150px] rounded-[1.6rem] border border-white/10 bg-slate-950/45 p-6 shadow-xl backdrop-blur-2xl transition duration-300 hover:-translate-y-0.5 hover:border-blue-300/60 hover:bg-slate-950/60";

const metaClass = isPaper
  ? "text-xs tracking-[0.18em] text-blue-700"
  : "text-xs tracking-[0.18em] text-blue-200";

const titleClass = isPaper
  ? "mt-3 text-xl font-black text-slate-950 group-hover:text-blue-700"
  : "mt-3 text-xl font-black text-white group-hover:text-blue-100";

const descClass = isPaper
  ? "mt-3 text-sm leading-7 text-slate-600"
  : "mt-3 text-sm leading-7 text-slate-200";

const linkClass = isPaper
  ? "text-right text-sm text-blue-700"
  : "text-right text-sm text-blue-200";
---

<a href={href} class={cardClass}>
  <div class="flex h-full flex-col justify-between gap-5">
    <div>
      <p class={metaClass}>
        {category} · {date}
      </p>

      <h3 class={titleClass}>
        {title}
      </h3>

      <p class={descClass}>
        {description}
      </p>
    </div>

    <div class={linkClass}>
      阅读文章 →
    </div>
  </div>
</a>
