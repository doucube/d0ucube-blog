---
import { siteConfig } from "../data/site.ts";
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-slate-950/60 backdrop-blur-2xl">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-8 px-6 py-4">
    <a href="/" class="shrink-0 text-base font-black tracking-[0.32em] text-white">
      {siteConfig.name.toUpperCase()}
    </a>

    <nav class="hidden items-center gap-10 text-sm text-slate-200 md:flex lg:gap-12">
      {siteConfig.nav.map((item) => (
        <a
          href={item.href}
          class="group relative py-2 transition duration-300 hover:text-blue-200"
        >
          {item.label}
          <span class="absolute -bottom-0.5 left-1/2 h-[2px] w-0 -translate-x-1/2 rounded-full bg-blue-300 transition-all duration-300 group-hover:w-full"></span>
        </a>
      ))}
    </nav>

    <form action="/search" method="get" class="hidden w-64 md:block">
      <div class="flex items-center rounded-full border border-white/10 bg-white/10 px-4 py-2 shadow-inner backdrop-blur-xl transition focus-within:border-blue-300/70 focus-within:bg-white/15">
        <svg viewBox="0 0 24 24" class="mr-2 h-4 w-4 fill-none stroke-slate-300 stroke-2">
          <path d="M21 21l-4.3-4.3" />
          <circle cx="11" cy="11" r="7" />
        </svg>

        <input
          name="q"
          type="search"
          placeholder="搜索文章..."
          class="w-full bg-transparent text-sm text-white outline-none placeholder:text-slate-400"
        />
      </div>
    </form>
  </div>
</header>
